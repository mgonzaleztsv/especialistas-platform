generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  SPECIALIST
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum ClientStatus {
  INCOMPLETE
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  phone        String?
  passwordHash String
  role         UserRole
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  client       Client?
  specialist   Specialist?
  locations    Location[]
  sentMessages        Message[]
  terminationRequests TerminationRequest[]
  damageClaimsRequested DamageClaim[]
  notifications Notification[]
}

model Client {
  completionClaims CompletionClaim[]
  id          String       @id @default(uuid())
  userId      String       @unique
  clientType  String       @default("INDIVIDUAL")
  status      ClientStatus @default(INCOMPLETE)
  companyName String?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobRequests JobRequest[]
  reviews     Review[]
  specialistReviews SpecialistReview[]
  paymentsMade Payment[]
  createdAt   DateTime     @default(now())
}

model Specialist {
  id                 String               @id @default(uuid())
  userId             String               @unique
  description        String?
  experienceYears    Int                  @default(0)
  hourlyRate         Decimal?             @db.Decimal(10, 2)
  availabilityStatus String               @default("AVAILABLE")
  verificationStatus VerificationStatus   @default(PENDING)
  trustScore         Int                  @default(0)
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories         SpecialistCategory[]
  serviceAreas       ServiceArea[]
  documents          Document[]
  portfolioItems     PortfolioItem[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  proposals          Proposal[]
  reviews          Review[]
  clientReviews SpecialistReview[]
  paymentsReceived Payment[]
}

model Category {
  id          String               @id @default(uuid())
  name        String               @unique
  slug        String               @unique
  description String?
  active      Boolean              @default(true)
  specialists SpecialistCategory[]
  jobRequests JobRequest[]
}

model SpecialistCategory {
  specialistId String
  categoryId   String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([specialistId, categoryId])
}

model Location {
  id        String   @id @default(uuid())
  userId    String
  address   String?
  city      String
  state     String
  zipcode   String?
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Document {
  id             String             @id @default(uuid())
  specialistId   String
  documentType   String
  fileUrl        String
  expirationDate DateTime?
  status         VerificationStatus @default(PENDING)
  specialist     Specialist         @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
}

model PortfolioItem {
  id           String     @id @default(uuid())
  specialistId String
  title        String
  description  String?
  imageUrl     String?
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
}

enum JobRequestStatus {
  DRAFT
  PUBLISHED
  RECEIVING_QUOTES
  PENDING_AGREEMENT
  AWAITING_PAYMENT
  ASSIGNED
  IN_PROGRESS
  AWAITING_CLIENT_CONFIRMATION
  TERMINATION_REQUESTED
  DISPUTED
  COMPLETED
  CANCELLED
}

model JobRequest {
  reviewPeriodHours Int?
  workCompletedAt   DateTime?
  reviewDeadline    DateTime?
  id          String           @id @default(uuid())
  clientId    String
  categoryId  String
  title       String
  description String
  budgetMin   Decimal?         @db.Decimal(10, 2)
  budgetMax   Decimal?         @db.Decimal(10, 2)
  city        String
  state       String
  zipcode     String?
  serviceAddress String?
  latitude    Decimal?         @db.Decimal(10, 7)
  longitude   Decimal?         @db.Decimal(10, 7)
  locationVerificationStatus JobLocationVerificationStatus @default(UNVERIFIED)
  locationVerifiedAt DateTime?
  desiredDate DateTime?
  status      JobRequestStatus @default(PUBLISHED)
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category    Category         @relation(fields: [categoryId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  proposals   Proposal[]
  review      Review?
  specialistReview SpecialistReview?
  messages         Message[]
  payment            Payment?
  terminationRequest TerminationRequest?
  completionClaims CompletionClaim[]
  workOrders         WorkOrder[]
  notifications Notification[]
}

model Message {
  id           String     @id @default(uuid())
  jobRequestId String
  senderId     String
  body         String
  readAt       DateTime?
  createdAt    DateTime   @default(now())

  jobRequest   JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  sender       User       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([jobRequestId, createdAt])
  @@index([senderId])
}

enum ProposalStatus {
  PENDING
  SELECTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Proposal {
  id            String         @id @default(uuid())
  jobRequestId  String
  specialistId  String
  amount          Decimal        @db.Decimal(10, 2)
  materialsAmount Decimal        @default(0) @db.Decimal(10, 2)
  includedScope   String?
  excludedScope   String?
  message         String?
  availableDate   DateTime?
  status          ProposalStatus @default(PENDING)

  jobRequest JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobRequestId, specialistId])
  payment    Payment?
  workOrders WorkOrder[]
}

enum WorkOrderStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  SUPERSEDED
  CANCELLED
}

enum WorkOrderRespondingParty {
  CLIENT
  SPECIALIST
}

enum WorkOrderClosureReason {
  CLIENT_REJECTED
  SPECIALIST_WITHDREW
  RESPONSE_DEADLINE_EXPIRED
}

model WorkOrder {
  reviewPeriodHours Int?
  id                   String          @id @default(uuid())
  jobRequestId         String
  proposalId           String
  negotiationId        String?
  version              Int
  status               WorkOrderStatus @default(PENDING_ACCEPTANCE)

  title                String
  description          String
  includedScope        String?
  excludedScope        String?

  city                 String
  state                String
  zipcode              String?
  scheduledDate        DateTime?

  laborAmount          Decimal         @db.Decimal(10, 2)
  materialsAmount      Decimal         @default(0) @db.Decimal(10, 2)
  currency             String          @default("USD")

  templateVersion      String          @default("0.1")

  clientAcceptedAt     DateTime?
  specialistAcceptedAt DateTime?

respondingParty      WorkOrderRespondingParty?
  responseDeadline     DateTime?

  extensionRequestedAt DateTime?
  extensionApprovedAt  DateTime?
  extensionRejectedAt  DateTime?

  reminder24SentAt     DateTime?
  reminder42SentAt     DateTime?

  closedAt             DateTime?
  closureReason        WorkOrderClosureReason?
  jobRequest JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  proposal   Proposal   @relation(fields: [proposalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobRequestId, version])
  @@index([proposalId])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  PAID
  RELEASED
  REFUNDED
  SETTLED
  CANCELLED
  FAILED
}

model Payment {
  id                String        @id @default(uuid())
  jobRequestId      String        @unique
  proposalId        String        @unique
  clientId          String
  specialistId      String
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("USD")
  status            PaymentStatus @default(PENDING)

  provider          String?
  providerPaymentId String?       @unique

  paidAt            DateTime?
  releasedAt        DateTime?
  refundedAt        DateTime?

  jobRequest JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  proposal   Proposal   @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  client     Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([specialistId])
  movements PaymentMovement[]

  @@index([status])
}

enum PaymentMovementType {
  SPECIALIST_PAYOUT
  CLIENT_REFUND
  PENALTY
}

model PaymentMovement {
  id          String              @id @default(uuid())
  paymentId   String
  type        PaymentMovementType
  amount      Decimal             @db.Decimal(10, 2)
  currency    String              @default("USD")
  description String?
  createdAt   DateTime            @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([type])
}

enum TerminationRequesterRole {
  CLIENT
  SPECIALIST
}

enum TerminationStatus {
  PENDING
  ACCEPTED
  DISPUTED
  RESOLVED
}

enum TerminationLiability {
  UNDETERMINED
  CLIENT
  SPECIALIST
  NONE
}

model TerminationRequest {
  id             String                    @id @default(uuid())
  jobRequestId   String                    @unique
  requestedById  String
  requesterRole      TerminationRequesterRole
  jobStatusAtRequest JobRequestStatus
  reasonCode         String
  reasonDetails  String?
  status             TerminationStatus         @default(PENDING)
  claimedLiability   TerminationLiability      @default(UNDETERMINED)
  liability          TerminationLiability      @default(UNDETERMINED)

  specialistPayoutAmount Decimal? @db.Decimal(10, 2)
  clientRefundAmount     Decimal? @db.Decimal(10, 2)
  penaltyAmount          Decimal? @db.Decimal(10, 2)
  disputeNotes           String?
  resolutionNotes        String?

  respondedAt DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobRequest  JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  requestedBy  User          @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  damageClaims DamageClaim[]

  @@index([requestedById])
  @@index([status])
}

enum DamageClaimType {
  RESTITUTION
  COMPENSATION
  BOTH
}

enum DamageClaimStatus {
  PENDING
  ACCEPTED
  DISPUTED
  RESOLVED
  REJECTED
}

enum DamageCoverageSource {
  UNDETERMINED
  RESPONSIBLE_PARTY
  PLATFORM_INSURANCE
  PLATFORM
}

model DamageClaim {
  id                   String               @id @default(uuid())
  terminationRequestId String
  claimedById          String
  claimedAgainst       TerminationLiability
  type                 DamageClaimType
  description          String
  claimedAmount        Decimal?             @db.Decimal(10, 2)
  approvedAmount       Decimal?             @db.Decimal(10, 2)
  status               DamageClaimStatus    @default(PENDING)
  coverageSource       DamageCoverageSource @default(UNDETERMINED)
  insuranceReference   String?
  resolutionNotes      String?
  resolvedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  terminationRequest TerminationRequest @relation(fields: [terminationRequestId], references: [id], onDelete: Cascade)
  claimedBy          User               @relation(fields: [claimedById], references: [id], onDelete: Restrict)

  @@index([terminationRequestId])
  @@index([claimedById])
  @@index([status])
}

model Review {
  id           String   @id @default(uuid())
  jobRequestId String   @unique
  clientId     String
  specialistId String
  rating       Int
  comment      String?

  jobRequest JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([specialistId])
}


model SpecialistReview {
  id           String   @id @default(uuid())
  jobRequestId String   @unique
  specialistId String
  clientId     String
  rating       Int
  comment      String?

  jobRequest JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([specialistId])
  @@index([clientId])
}


model ServiceArea {
  id              String     @id @default(uuid())
  specialistId    String
  name            String
  centerLatitude  Decimal    @db.Decimal(10, 7)
  centerLongitude Decimal    @db.Decimal(10, 7)
  radiusMiles     Int
  isActive        Boolean    @default(true)
  specialist      Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([specialistId, isActive])
}


model Notification {
  id           String    @id @default(uuid())
  userId       String
  jobRequestId String
  type         String
  title        String
  body         String
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobRequest   JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)

  @@unique([userId, jobRequestId, type])
  @@index([userId, readAt, createdAt])
}


model NotificationOutbox {
  id             String    @id @default(uuid())
  jobRequestId   String
  eventType      String
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([jobRequestId, eventType])
  @@index([status, nextAttemptAt])
}


enum JobLocationVerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum CompletionClaimStatus {
  PENDING
  CORRECTION_REQUESTED
  DISPUTED
  RESOLVED
  REJECTED
}

model CompletionClaim {
  id             String                @id @default(uuid())
  jobRequestId   String
  clientId       String
  description    String
  status         CompletionClaimStatus @default(PENDING)
  specialistResponseNotes String?
  specialistRespondedAt   DateTime?
  disputedAt DateTime?

  correctionCompletedAt     DateTime?
  correctionReviewDeadline  DateTime?
  correctionCompletionNotes String?
  clientCorrectionAcceptedAt DateTime?
  clientCorrectionRespondedAt DateTime?
  clientCorrectionResponseNotes String?
  resolutionNotes String?
  resolvedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  jobRequest JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([jobRequestId, status])
  @@index([clientId])
}
