generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  SPECIALIST
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  phone        String?
  passwordHash String
  role         UserRole
  status       UserStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  client       Client?
  specialist   Specialist?
  locations    Location[]
}

model Client {
  id          String   @id @default(uuid())
  userId      String   @unique
  clientType  String   @default("INDIVIDUAL")
  companyName String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Specialist {
  id                 String                 @id @default(uuid())
  userId             String                 @unique
  description        String?
  experienceYears    Int                    @default(0)
  hourlyRate         Decimal?               @db.Decimal(10,2)
  availabilityStatus String                 @default("AVAILABLE")
  verificationStatus VerificationStatus     @default(PENDING)
  trustScore         Int                    @default(0)
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories         SpecialistCategory[]
  documents          Document[]
  portfolioItems     PortfolioItem[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

model Category {
  id          String                 @id @default(uuid())
  name        String                 @unique
  slug        String                 @unique
  description String?
  active      Boolean                @default(true)
  specialists SpecialistCategory[]
}

model SpecialistCategory {
  specialistId String
  categoryId   String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([specialistId, categoryId])
}

model Location {
  id        String  @id @default(uuid())
  userId    String
  address   String?
  city      String
  state     String
  zipcode   String?
  latitude  Decimal? @db.Decimal(10,7)
  longitude Decimal? @db.Decimal(10,7)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Document {
  id             String             @id @default(uuid())
  specialistId   String
  documentType   String
  fileUrl        String
  expirationDate DateTime?
  status         VerificationStatus @default(PENDING)
  specialist     Specialist         @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
}

model PortfolioItem {
  id           String     @id @default(uuid())
  specialistId String
  title        String
  description  String?
  imageUrl     String?
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
}
